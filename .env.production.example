# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment for docker compose.
#
#   On the server:  cp .env.production.example .env   (then fill every CHANGE_ME)
#
# Never commit the filled-in file — it holds secrets. The backend REFUSES to boot
# if any secret below is left at a dev default (see backend/app/config.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── App mode ──
APP_ENV=production
SEED_DEMO_DATA=false          # no demo districts/users/tutorials; real data only

# ── Host binding & ports ──
# Keep on localhost: the host-level nginx (TLS) is the ONLY public entrypoint.
BIND_ADDR=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ── Postgres ──
POSTGRES_USER=nurturehub
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password   # use a long value; e.g. `openssl rand -hex 24`
POSTGRES_DB=nurturehub

# ── Secrets (REQUIRED — boot fails without real values) ──
# Generate on the server:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Public origin / CORS ──
# The https domain the host nginx serves. (With the same-origin proxy, CORS only
# applies to cross-origin API calls, but set it correctly anyway.)
CORS_ORIGINS=https://nurturehub.example.org

# ── Email (OTP) — REQUIRED in production ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@yourdomain.org
SMTP_PASSWORD=CHANGE_ME_smtp_app_password
SMTP_FROM=NurtureHUB <noreply@yourdomain.org>

# ── Google OAuth (optional; blank => mock login disabled path uses email/OTP) ──
GOOGLE_CLIENT_ID=

# ═════════════════════════════════════════════════════════════════════════════
# DATA PROTECTION — required for the MOU data-privacy clause and Indian law.
# The backend REFUSES to boot in production without the keys marked REQUIRED.
# Generate every key ON THE SERVER, and keep them out of version control.
# ═════════════════════════════════════════════════════════════════════════════

# ── Field encryption (REQUIRED) ──
# Seals mothers' and learners' phone numbers and email addresses at rest, so a
# stolen dump, replica or backup yields ciphertext. Versioned so keys can be
# rotated without a flag-day rewrite — keep OLD versions listed or rows written
# under them become unreadable.
#
#   docker compose exec backend python -c \
#     "from app.security.crypto import generate_key; print('v1:'+generate_key())"
#
# After first setting these on an existing database, seal the rows already there:
#   docker compose exec backend python -m scripts.encrypt_phi --dry-run
#   docker compose exec backend python -m scripts.encrypt_phi
PHI_ENCRYPTION_KEYS=CHANGE_ME_v1:base64url_32_bytes
PHI_ENCRYPTION_ACTIVE_KEY=v1
# Separate key for the searchable blind index, so leaking one does not
# compromise the other:  openssl rand -base64 32
PHI_INDEX_KEY=CHANGE_ME_openssl_rand_base64_32

# ── Audit trail signing (REQUIRED) ──
# Signs every audit row so the access history cannot be quietly edited by anyone
# who reaches the database. MUST differ from JWT_SECRET_KEY — sharing them means
# one leak forges both sessions and the log that would have recorded it.
#   openssl rand -hex 32
AUDIT_HMAC_KEY=CHANGE_ME_openssl_rand_hex_32_DIFFERENT_FROM_JWT

# ── Accountable contact (REQUIRED) ──
# Published in the privacy notice and in every breach notification. The DPDP Act
# requires a real, reachable contact for data-principal requests.
ORG_LEGAL_NAME=Spoken Tutorial Project, IIT Bombay
DPO_NAME=CHANGE_ME Full Name
DPO_EMAIL=CHANGE_ME@yourdomain.org
DPO_PHONE=+91-CHANGE_ME
PUBLIC_BASE_URL=https://nurturehub.example.org

# ── Host pinning (REQUIRED) ──
# OTP and password-reset mails are built from the request host; a forged Host
# header would point a verification link at someone else's server.
#
# The FIRST entry is also the Host the container healthcheck probes with, since
# setting this installs TrustedHostMiddleware and any other Host is answered 400.
# Comma-separate if the app answers to more than one name.
ALLOWED_HOSTS=nurturehub.example.org

# ── Administrator accounts ──
# Set ADMIN_BOOTSTRAP_PASSWORD once to create the first administrator on an
# empty database, then REMOVE it — production will not boot while it is set.
# It must satisfy the password policy (12+ chars for admins).
#ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.org
#ADMIN_BOOTSTRAP_PASSWORD=
ALLOW_DEV_ADMIN=false
# Enrol every administrator with an authenticator app FIRST (Data Protection →
# Access control), then set this to true. Turning it on before anyone has
# enrolled locks every administrator out of the console.
MFA_REQUIRED_FOR_ADMINS=false

# ── Transport / exposure ──
HSTS_ENABLED=true
ENABLE_API_DOCS=false          # do not publish a map of the API surface
SERVE_LOCAL_UPLOADS=false      # media belongs on R2; this mount is unauthenticated
RAW_EXPORT_MOCK=false          # never fabricate data in production
# Behind the host nginx every peer is 127.0.0.1. Turn this on so rate limits and
# audit rows record the real client address — ONLY because a proxy we control
# sets X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# ── Sessions ──
# Set to false about 24h after the first deploy of this layer, once every
# pre-existing token has expired. Until then it keeps field workers signed in.
SESSION_ALLOW_LEGACY_TOKENS=true

# ── Detection thresholds — tune to the real caseload ──
#BULK_READ_SUBJECT_THRESHOLD=60
#EXPORT_RECORD_THRESHOLD=250
#WORK_HOURS_START=6
#WORK_HOURS_END=22

# ── Breach reporting clocks, in hours from discovery ──
# Defaults are the conservative reading of the operative texts. Confirm against
# the notified DPDP Rules and the executed MOU annexure before go-live.
#BREACH_CERTIN_HOURS=6         # CERT-In Directions 28.04.2022
#BREACH_DPB_INITIAL_HOURS=6    # DPDP Act 2023 s.8(6)
#BREACH_DPB_DETAILED_HOURS=72
#BREACH_PRINCIPALS_HOURS=72
#BREACH_MOU_HOURS=24           # contractual — set from the signed annexure
#DSR_RESPONSE_DAYS=30

# ═════════════════════════════════════════════════════════════════════════════
# CAPACITY — read before a test goes live
# ═════════════════════════════════════════════════════════════════════════════
# Measured on a 16-core box, one worker: ~26 sign-ins/second, and 300 health
# workers signing in complete in ~12 seconds with a p95 wait of ~2s.
#
# The wall is bcrypt, not the database: at BCRYPT_ROUNDS=12 each verification
# costs ~310ms of CPU, so 300 sign-ins is ~93 CPU-seconds no matter how the
# rest is tuned. The levers, in order of preference:
#   1. more cores / more workers  (capacity scales with CPU)
#   2. BCRYPT_ROUNDS=10           (~4x cheaper; existing hashes upgrade on next
#                                  sign-in; 10 is the floor OWASP accepts)
#   3. stagger the start          (arrivals spread over even 30s are trivial)
#
# Rate limits on the sign-in path are FLOOD CEILINGS, not brute-force controls —
# a whole block office shares one NAT address, so a tight per-address limit
# would throttle a district while doing nothing to an attacker. Brute force is
# handled per account by LOCKOUT_* above.
#RATE_LIMIT_LOGIN=1200/minute
#RATE_LIMIT_OTP=120/minute
#RATE_LIMIT_REGISTER=60/hour
# Authenticated endpoints are keyed by ACCOUNT, so these can be tight safely.
#RATE_LIMIT_EXPORT=30/hour
#RATE_LIMIT_PIPELINE=12/hour
#BCRYPT_ROUNDS=12

# Connection pool. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) * workers under
# Postgres max_connections. A burst larger than the pool now returns a fast,
# retryable 503 rather than hanging for the timeout and then erroring.
#DB_POOL_SIZE=20
#DB_MAX_OVERFLOW=40
#DB_POOL_TIMEOUT=8

# ── Frontend build-time API/WS base ──
# Leave BLANK: the browser uses the same origin, and the frontend nginx proxies
# /api and /ws to the backend. (These are baked at image build — rebuild if changed.)
VITE_API_URL=
VITE_WS_URL=

# Local Python env / caches — never copy into the image
venv/
venv-win/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tests and their runner — the image installs requirements.txt only, so pytest
# is not present to run them anyway.
tests/
requirements-dev.txt

# Secrets & local config (env comes from docker-compose)
.env
.env.*

# Runtime data (mounted as volumes, never baked into the image)
pipeline_data/
uploads/
form_backups/
# Local audit spool — holds real audit events; never bake it into an image.
audit_spool.jsonl

# VCS / editor / docs
.git/
.gitignore
.vscode/
.idea/
*.md
